<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/charging_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/remrss_oled_background">

    <top.zainzh.rearscreen.ChargingLiquidView
        android:id="@+id/full_screen_liquid"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Only the foreground group avoids the current window's camera cutout. -->
    <LinearLayout
        android:id="@+id/charging_text_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <TextView
            android:id="@+id/battery_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="60sp"
            android:textStyle="bold"
            android:textColor="@color/remrss_on_oled"
            android:shadowColor="#80000000"
            android:shadowRadius="8"
            android:shadowDy="2"
            android:letterSpacing="0.01" />
        <TextView
            android:id="@+id/charging_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textSize="15sp"
            android:textColor="@color/remrss_on_oled"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>
